#: aequilibrae/paths/connectivity_analysis.py:13
msgid ""
"\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> from aequilibrae.paths.connectivity_analysis import ConnectivityAnalysis\n"
"\n"
"        >>> project = create_example(project_path)\n"
"\n"
"        >>> network = project.network\n"
"        >>> network.build_graphs()\n"
"\n"
"        >>> graph = network.graphs['c']\n"
"        >>> graph.set_graph(cost_field=\"distance\")\n"
"        >>> graph.set_blocked_centroid_flows(False)\n"
"\n"
"        >>> conn_test = ConnectivityAnalysis(graph)\n"
"        >>> conn_test.execute()\n"
"\n"
"        # The connectivity tester report as a Pandas DataFrame\n"
"        >>> disconnected = conn_test.disconnected_pairs\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
".. bloque de código:: python\n"
"\n"
"        >>> desde aequilibrae.paths.connectivity_analysis importar ConnectivityAnalysis\n"
"\n"
"        >>> proyecto = crear_ejemplo(ruta_proyecto)\n"
"\n"
"        >>> red = proyecto.red\n"
"        >>> red.build_graphs()\n"
"\n"
"        >>> gráfico = red.grafos['c']\n"
"        >>> gráfico.set_graph(coste_campo=\"distancia\")\n"
"        >>> graph.set_blocked_centroid_flows(Falso)\n"
"\n"
"        >>> conn_test = Análisis de conectividad(gráfico)\n"
"        >>> conn_test.ejecutar()\n"
"\n"
"        # El informe del probador de conectividad como Pandas DataFrame\n"
"        >>> desconectado = conn_test.desconectados_pares\n"
"\n"
"        >>> proyecto.cerrar()"

#: aequilibrae/paths/network_skimming.py:21
msgid ""
"\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> from aequilibrae.paths.network_skimming import NetworkSkimming\n"
"\n"
"        >>> project = create_example(project_path)\n"
"        >>> project.network.build_graphs(modes=[\"c\"])\n"
"\n"
"        >>> graph = project.network.graphs['c']\n"
"        >>> graph.set_graph(\"distance\")\n"
"        >>> graph.set_skimming(\"distance\")\n"
"\n"
"        >>> skm = NetworkSkimming(graph)\n"
"        >>> skm.execute()\n"
"\n"
"        # The skim report (if any error generated) is available here\n"
"        >>> skm.report\n"
"        []\n"
"\n"
"        # To access the skim matrix directly from its temporary file\n"
"        >>> matrix = skm.results.skims\n"
"\n"
"        # Or you can save the results to disk\n"
"        >>> skm.save_to_project('skimming_result_omx', 'omx')\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
".. bloque de código:: python\n"
"\n"
"        >>> desde aequilibrae.paths.network_skimming importar NetworkSkimming\n"
"\n"
"        >>> proyecto = crear_ejemplo(ruta_proyecto)\n"
"        >>> proyecto.network.build_graphs(modos=[\"c\"])\n"
"\n"
"        >>> gráfico = proyecto.network.graphs['c']\n"
"        >>> gráfico.set_graph(\"distancia\")\n"
"        >>> graph.set_skimming(\"distancia\")\n"
"\n"
"        >>> skm = NetworkSkimming(gráfico)\n"
"        >>> skm.ejecutar()\n"
"\n"
"        # El informe desnatado (si se generó algún error) está disponible aquí\n"
"        >>> informe skm\n"
"        []\n"
"\n"
"        # Para acceder a la matriz skim directamente desde su archivo temporal\n"
"        >>> matriz = skm.resultados.skims\n"
"\n"
"        # O puedes guardar los resultados en el disco.\n"
"        >>> skm.save_to_project('skimming_result_omx', 'omx')\n"
"\n"
"        >>> proyecto.cerrar()"

