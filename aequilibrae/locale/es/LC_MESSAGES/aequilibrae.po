#: aequilibrae/paths/traffic_assignment.py:179
#, python-brace-format
msgid ""
"Traffic assignment class.\n"
"\n"
"    For a comprehensive example on use, see the Use examples page.\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> from aequilibrae.paths import TrafficAssignment, TrafficClass\n"
"\n"
"        >>> project = create_example(project_path)\n"
"        >>> project.network.build_graphs()\n"
"\n"
"        >>> graph = project.network.graphs['c'] # we grab the graph for cars\n"
"        >>> graph.set_graph('free_flow_time') # let's say we want to minimize time\n"
"        >>> graph.set_skimming(['free_flow_time', 'distance']) # And will skim time and distance\n"
"        >>> graph.set_blocked_centroid_flows(True)\n"
"\n"
"        >>> proj_matrices = project.matrices\n"
"\n"
"        >>> demand = proj_matrices.get_matrix(\"demand_omx\")\n"
"\n"
"        # We will only assign one user class stored as 'matrix' inside the OMX file\n"
"        >>> demand.computational_view(['matrix'])\n"
"\n"
"        # Creates the assignment class\n"
"        >>> assigclass = TrafficClass(\"car\", graph, demand)\n"
"\n"
"        >>> assig = TrafficAssignment()\n"
"\n"
"        # The first thing to do is to add at list of traffic classes to be assigned\n"
"        >>> assig.set_classes([assigclass])\n"
"\n"
"        # Then we set the volume delay function\n"
"        >>> assig.set_vdf(\"BPR\")  # This is not case-sensitive\n"
"\n"
"        # And its parameters\n"
"        >>> assig.set_vdf_parameters({\"alpha\": \"b\", \"beta\": \"power\"})\n"
"\n"
"        # The capacity and free flow travel times as they exist in the graph\n"
"        >>> assig.set_capacity_field(\"capacity\")\n"
"        >>> assig.set_time_field(\"free_flow_time\")\n"
"\n"
"        # And the algorithm we want to use to assign\n"
"        >>> assig.set_algorithm('bfw')\n"
"\n"
"        >>> assig.max_iter = 10\n"
"        >>> assig.rgap_target = 0.00001\n"
"\n"
"        >>> assig.execute() # we then execute the assignment\n"
"\n"
"        # If you want, it is possible to access the convergence report\n"
"        >>> convergence_report = pd.DataFrame(assig.assignment.convergence_report)\n"
"\n"
"        # Assignment results can be viewed as a Pandas DataFrame\n"
"        >>> results_df = assig.results()\n"
"\n"
"        # Information on the assignment setup can be recovered with\n"
"        >>> info = assig.info()\n"
"\n"
"        # Or save it directly to the results database\n"
"        >>> results = assig.save_results(table_name='base_year_assignment')\n"
"\n"
"        # skims are here\n"
"        >>> avg_skims = assigclass.results.skims # blended ones\n"
"        >>> last_skims = assigclass._aon_results.skims # those for the last iteration\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Clase de asignación de tráfico.\n"
"\n"
"    Para obtener un ejemplo completo de uso, consulte la página de ejemplos de uso.\n"
"\n"
"    .. bloque de código:: python\n"
"\n"
"        >>> desde aequilibrae.paths importar TrafficAssignment, TrafficClass\n"
"\n"
"        >>> proyecto = crear_ejemplo(ruta_proyecto)\n"
"        >>> proyecto.network.build_graphs()\n"
"\n"
"        >>> gráfico = proyecto.network.graphs['c'] # tomamos el gráfico para automóviles\n"
"        >>> graph.set_graph('free_flow_time') # digamos que queremos minimizar el tiempo\n"
"        >>> graph.set_skimming(['free_flow_time', 'distance']) # Y hojeará el tiempo y la distancia\n"
"        >>> graph.set_blocked_centroid_flows(Verdadero)\n"
"\n"
"        >>> proj_matrices = proyecto.matrices\n"
"\n"
"        >>> demanda = proj_matrices.get_matrix(\"demanda_omx\")\n"
"\n"
"        # Solo asignaremos una clase de usuario almacenada como 'matriz' dentro del archivo OMX\n"
"        >>> demanda.computational_view(['matriz'])\n"
"\n"
"        # Crea la clase de tarea\n"
"        >>> assigclass = TrafficClass(\"coche\", gráfico, demanda)\n"
"\n"
"        >>> asignación = Asignación de tráfico()\n"
"\n"
"        # Lo primero que debe hacer es agregar una lista de clases de tráfico que se asignarán\n"
"        >>> assig.set_classes([assigclase])\n"
"\n"
"        # Luego configuramos la función de retardo de volumen.\n"
"        >>> assig.set_vdf(\"BPR\") # Esto no distingue entre mayúsculas y minúsculas\n"
"\n"
"        # Y sus parámetros\n"
"        >>> assig.set_vdf_parameters({\"alfa\": \"b\", \"beta\": \"potencia\"})\n"
"\n"
"        # La capacidad y los tiempos de viaje de flujo libre tal como existen en el gráfico.\n"
"        >>> assig.set_capacity_field(\"capacidad\")\n"
"        >>> assig.set_time_field(\"tiempo_flujo_libre\")\n"
"\n"
"        # Y el algoritmo que queremos usar para asignar\n"
"        >>> assig.set_algorithm('bfw')\n"
"\n"
"        >>> asignación.max_iter = 10\n"
"        >>> assig.rgap_target = 0.00001\n"
"\n"
"        >>> assig.execute() # luego ejecutamos la tarea\n"
"\n"
"        # Si lo deseas, es posible acceder al informe de convergencia.\n"
"        >>> informe_convergencia = pd.DataFrame(assig.assignment.report_convergencia)\n"
"\n"
"        # Los resultados de la tarea se pueden ver como un Pandas DataFrame\n"
"        >>> resultados_df = assig.resultados()\n"
"\n"
"        # La información sobre la configuración de la tarea se puede recuperar con\n"
"        >>> información = assig.info()\n"
"\n"
"        # O guárdelo directamente en la base de datos de resultados.\n"
"        >>> resultados = assig.save_results(nombre_tabla='asignación_año_base')\n"
"\n"
"        # desnatados están aquí\n"
"        >>> avg_skims = assigclass.results.skims # combinados\n"
"        >>> last_skims = assigclass._aon_results.skims # aquellos de la última iteración\n"
"\n"
"        >>> proyecto.cerrar()"

