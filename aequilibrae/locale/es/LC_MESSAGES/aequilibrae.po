"\n"
"    .. bloque de código:: python\n"
"\n"
"        >>> proyecto = crear_ejemplo(ruta_proyecto)\n"
"\n"
"        >>> zonificación = proyecto.zonificación\n"
"\n"
"        >>> zona_centro = zonificación.get(1)\n"
"        >>> zona_centro.población = 637\n"
"        >>> zona_centro.empleo = 10039\n"
"        >>> zona_centro.guardar()\n"
"\n"
"        # También podemos agregar un campo más a la tabla.\n"
"        >>> campos = zonificación.campos\n"
"        >>> campos.add('parking_spots', 'Total de plazas de aparcamiento con licencia', 'INTEGER')\n"
"\n"
"        >>> proyecto.cerrar()"

#: aequilibrae/project/network/link_types.py:9
#, python-format
msgid ""
"\n"
"    Access to the API resources to manipulate the link_types table in the network.\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> project = create_example(project_path)\n"
"\n"
"        >>> link_types = project.network.link_types\n"
"\n"
"        # We can get a dictionary of link types in the model\n"
"        >>> all_link_types = link_types.all_types()\n"
"\n"
"        # And do a bulk change and save it\n"
"        >>> for link_type_id, link_type_obj in all_link_types.items():\n"
"        ...     link_type_obj.beta = 1\n"
"\n"
"        # We can save changes for all link types in one go\n"
"        >>> link_types.save()\n"
"\n"
"        # or just get one link_type in specific\n"
"        >>> default_link_type = link_types.get('y')\n"
"\n"
"        # or just get it by name\n"
"        >>> default_link_type = link_types.get_by_name('default')\n"
"\n"
"        # We can change the description of the link types\n"
"        >>> default_link_type.description = 'My own new description'\n"
"\n"
"        # Let's say we are using alpha to store lane capacity during the night as 90% of the standard\n"
"        >>> default_link_type.alpha = 0.9 * default_link_type.lane_capacity\n"
"\n"
"        # To save this link types we can simply\n"
"        >>> default_link_type.save()\n"
"\n"
"        # We can also create a completely new link_type and add to the model\n"
"        >>> new_type = link_types.new('a')\n"
"        >>> new_type.link_type = 'Arterial'  # Only ASCII letters and *_* allowed # other fields are not mandatory\n"
"\n"
"        # We then save it to the database\n"
"        >>> new_type.save()\n"
"\n"
"        # we can even keep editing and save it directly once we have added it to the project\n"
"        >>> new_type.lanes = 3\n"
"        >>> new_type.lane_capacity = 1100\n"
"        >>> new_type.save()\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Acceso a los recursos API para manipular la tabla link_types en la red.\n"
"\n"
"    .. bloque de código:: python\n"
"\n"
"        >>> proyecto = crear_ejemplo(ruta_proyecto)\n"
"\n"
"        >>> tipos_enlace = proyecto.red.tipos_enlace\n"
"\n"
"        # Podemos obtener un diccionario de tipos de enlaces en el modelo.\n"
"        >>> all_link_types = link_types.all_types()\n"
"\n"
"        # Y haz un cambio masivo y guárdalo.\n"
"        >>> para link_type_id, link_type_obj en all_link_types.items():\n"
"        ... enlace_tipo_obj.beta = 1\n"
"\n"
"        # Podemos guardar cambios para todos los tipos de enlaces de una sola vez.\n"
"        >>> tipos_enlace.guardar()\n"
"\n"
"        # o simplemente obtener un tipo de enlace específico\n"
"        >>> default_link_type = link_types.get('y')\n"
"\n"
"        # o simplemente consíguelo por nombre\n"
"        >>> default_link_type = link_types.get_by_name('predeterminado')\n"
"\n"
"        # Podemos cambiar la descripción de los tipos de enlaces.\n"
"        >>> default_link_type.description = 'Mi nueva descripción'\n"
"\n"
"        # Digamos que estamos usando alfa para almacenar la capacidad del carril durante la noche como el 90% del "
"estándar.\n"
"        >>> default_link_type.alpha = 0.9 * default_link_type.lane_capacity\n"
"\n"
"        # Para guardar este tipo de enlaces simplemente podemos\n"
"        >>> default_link_type.save()\n"
"\n"
"        # También podemos crear un tipo de enlace completamente nuevo y agregarlo al modelo.\n"
"        >>> nuevo_tipo = tipos_enlace.nuevo('a')\n"
"        >>> new_type.link_type = 'Arterial' # Solo se permiten letras ASCII y *_* # otros campos no son obligatorios\n"
"\n"
"        # Luego lo guardamos en la base de datos.\n"
"        >>> nuevo_tipo.guardar()\n"
"\n"
"        # incluso podemos seguir editándolo y guardarlo directamente una vez que lo hayamos agregado al proyecto\n"
"        >>> nuevo_tipo.carriles = 3\n"
"        >>> nuevo_tipo.carril_capacidad = 1100\n"
"        >>> nuevo_tipo.guardar()\n"
"\n"
"        >>> proyecto.cerrar()"

#: aequilibrae/project/network/links.py:13
