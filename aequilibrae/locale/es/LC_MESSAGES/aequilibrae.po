"Path computation result holder\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> from aequilibrae.paths.results import PathResults\n"
"\n"
"        >>> project = create_example(project_path)\n"
"        >>> project.network.build_graphs()\n"
"\n"
"        # Mode c is car in this project\n"
"        >>> car_graph = project.network.graphs['c']\n"
"\n"
"        # minimize distance\n"
"        >>> car_graph.set_graph('distance')\n"
"\n"
"        # If you want to compute skims\n"
"        # It does increase path computation time substantially\n"
"        >>> car_graph.set_skimming(['distance', 'free_flow_time'])\n"
"\n"
"        >>> res = PathResults()\n"
"        >>> res.prepare(car_graph)\n"
"        >>> res.compute_path(1, 17)\n"
"\n"
"        # Update all the outputs mentioned above for destination 9. Same origin: 1\n"
"        >>> res.update_trace(9)\n"
"\n"
"        # clears all computation results\n"
"        >>> res.reset()\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Titular del resultado del cálculo de ruta\n"
"\n"
"    .. bloque de código:: python\n"
"\n"
"        >>> desde aequilibrae.paths.results importar PathResults\n"
"\n"
"        >>> proyecto = crear_ejemplo(ruta_proyecto)\n"
"        >>> proyecto.network.build_graphs()\n"
"\n"
"        # El modo c es un automóvil en este proyecto.\n"
"        >>> car_graph = proyecto.network.graphs['c']\n"
"\n"
"        # minimizar la distancia\n"
"        >>> car_graph.set_graph('distancia')\n"
"\n"
"        # Si desea calcular desnatados\n"
"        # Aumenta sustancialmente el tiempo de cálculo de la ruta\n"
"        >>> car_graph.set_skimming(['distancia', 'tiempo_flujo_libre'])\n"
"\n"
"        >>> res = ResultadosDeRuta()\n"
"        >>> res.preparar(car_graph)\n"
"        >>> res.compute_path(1, 17)\n"
"\n"
"        # Actualizar todas las salidas mencionadas anteriormente para el destino 9. Mismo origen: 1\n"
"        >>> res.update_trace(9)\n"
"\n"
"        # borra todos los resultados del cálculo\n"
"        >>> res.reset()\n"
"\n"
"        >>> proyecto.cerrar()"

