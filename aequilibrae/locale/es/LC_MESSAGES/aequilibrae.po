#: aequilibrae/project/network/modes.py:8
msgid ""
"\n"
"    Access to the API resources to manipulate the modes table in the network\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> project = create_example(project_path)\n"
"\n"
"        >>> modes = project.network.modes\n"
"\n"
"        # We can get a dictionary of all modes in the model\n"
"        >>> all_modes = modes.all_modes()\n"
"\n"
"        # And do a bulk change and save it\n"
"        >>> for mode_id, mode_obj in all_modes.items():\n"
"        ...     mode_obj.beta = 1\n"
"        ...     mode_obj.save()\n"
"\n"
"        # or just get one mode in specific\n"
"        >>> car_mode = modes.get('c')\n"
"\n"
"        # or just get this same mode by name\n"
"        >>> car_mode = modes.get_by_name('car')\n"
"\n"
"        # We can change the description of the mode\n"
"        >>> car_mode.description = 'personal autos only'\n"
"\n"
"        # Let's say we are using alpha to store the PCE for a future year with much smaller cars\n"
"        >>> car_mode.alpha = 0.95\n"
"\n"
"        # To save this mode we can simply\n"
"        >>> car_mode.save()\n"
"\n"
"        # We can also create a completely new mode and add to the model\n"
"        >>> new_mode = modes.new('k')\n"
"        >>> new_mode.mode_name = 'flying_car'  # Only ASCII letters and *_* allowed # other fields are not mandatory\n"
"\n"
"        # We then explicitly add it to the network\n"
"        >>> modes.add(new_mode)\n"
"\n"
"        # we can even keep editing and save it directly once we have added it to the project\n"
"        >>> new_mode.description = 'this is my new description'\n"
"        >>> new_mode.save()\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Acceso a los recursos API para manipular la tabla de modos en la red.\n"
"\n"
"    .. bloque de código:: python\n"
"\n"
"        >>> proyecto = crear_ejemplo(ruta_proyecto)\n"
"\n"
"        >>> modos = proyecto.red.modos\n"
"\n"
"        # Podemos obtener un diccionario de todos los modos en el modelo.\n"
"        >>> todos_modos = modos.todos_modos()\n"
"\n"
"        # Y haz un cambio masivo y guárdalo.\n"
"        >>> para mode_id, mode_obj en all_modes.items():\n"
"        ... modo_obj.beta = 1\n"
"        ... modo_obj.save()\n"
"\n"
"        # o simplemente obtener un modo en específico\n"
"        >>> modo_coche = modos.get('c')\n"
"\n"
"        # o simplemente obtener este mismo modo por nombre\n"
"        >>> modo_coche = modos.get_by_name('coche')\n"
"\n"
"        # Podemos cambiar la descripción del modo.\n"
"        >>> car_mode.description = 'solo autos personales'\n"
"\n"
"        # Digamos que estamos usando alfa para almacenar el PCE para un año futuro con autos mucho más pequeños\n"
"        >>> modo_automóvil.alfa = 0,95\n"
"\n"
"        # Para guardar este modo simplemente podemos\n"
"        >>> modo_automóvil.guardar()\n"
"\n"
"        # También podemos crear un modo completamente nuevo y agregarlo al modelo.\n"
"        >>> nuevo_modo = modos.nuevo('k')\n"
"        >>> new_mode.mode_name = 'flying_car' # Solo se permiten letras ASCII y *_* # otros campos no son "
"obligatorios\n"
"\n"
"        # Luego lo agregamos explícitamente a la red.\n"
"        >>> modos.añadir(nuevo_modo)\n"
"\n"
"        # incluso podemos seguir editándolo y guardarlo directamente una vez que lo hayamos agregado al proyecto\n"
"        >>> new_mode.description = 'esta es mi nueva descripción'\n"
"        >>> nuevo_modo.guardar()\n"
"\n"
"        >>> proyecto.cerrar()"

