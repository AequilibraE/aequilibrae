#: aequilibrae/project/network/link.py:8
msgid ""
"A Link object represents a single record in the *links* table\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> project = create_example(project_path)\n"
"\n"
"        >>> all_links = project.network.links\n"
"\n"
"        # Let's get a mode to work with\n"
"        >>> modes = project.network.modes\n"
"        >>> car_mode = modes.get('c')\n"
"\n"
"        # We can just get one link in specific\n"
"        >>> link1 = all_links.get(3)\n"
"        >>> link2 = all_links.get(17)\n"
"\n"
"        # We can find out which fields exist for the links\n"
"        >>> which_fields_do_we_have = link1.data_fields()\n"
"\n"
"        # And edit each one like this\n"
"        >>> link1.lanes_ab = 3\n"
"        >>> link1.lanes_ba = 2\n"
"\n"
"        # we can drop a mode from the link\n"
"        >>> link1.drop_mode(car_mode)  # or link1.drop_mode('c')\n"
"\n"
"        # we can add a mode to the link\n"
"        >>> link2.add_mode(car_mode)  # or link2.add_mode('c')\n"
"\n"
"        # Or set all modes at once\n"
"        >>> link2.set_modes('cbtw')\n"
"\n"
"        # We can just save the link\n"
"        >>> link1.save()\n"
"        >>> link2.save()\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Un objeto Enlace representa un único registro en la tabla *enlaces*\n"
"\n"
"    .. bloque de código:: python\n"
"\n"
"        >>> proyecto = crear_ejemplo(ruta_proyecto)\n"
"\n"
"        >>> todos_enlaces = proyecto.red.enlaces\n"
"\n"
"        # Consigamos un modo con el que trabajar\n"
"        >>> modos = proyecto.red.modos\n"
"        >>> modo_coche = modos.get('c')\n"
"\n"
"        # Podemos obtener solo un enlace en específico\n"
"        >>> enlace1 = todos_enlaces.get(3)\n"
"        >>> enlace2 = todos_enlaces.get(17)\n"
"\n"
"        # Podemos averiguar qué campos existen para los enlaces.\n"
"        >>> cuales_campos_tenemos_tenemos = enlace1.campos_de_datos()\n"
"\n"
"        # Y edita cada uno así\n"
"        >>> enlace1.lanes_ab = 3\n"
"        >>> enlace1.lanes_ba = 2\n"
"\n"
"        # podemos eliminar un modo desde el enlace\n"
"        >>> link1.drop_mode(car_mode) # o link1.drop_mode('c')\n"
"\n"
"        # podemos agregar un modo al enlace\n"
"        >>> link2.add_mode(car_mode) # o link2.add_mode('c')\n"
"\n"
"        # O configurar todos los modos a la vez\n"
"        >>> enlace2.set_modes('cbtw')\n"
"\n"
"        # Podemos simplemente guardar el enlace.\n"
"        >>> enlace1.guardar()\n"
"        >>> enlace2.guardar()\n"
"\n"
"        >>> proyecto.cerrar()"

