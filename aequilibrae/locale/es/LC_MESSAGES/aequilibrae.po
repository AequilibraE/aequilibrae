#: aequilibrae/paths/results/skim_results.py:8
msgid ""
"\n"
"    Network skimming result holder.\n"
"\n"
"    .. code-block:: python\n"
"\n"
"          >>> from aequilibrae.paths.results import SkimResults\n"
"\n"
"          >>> project = create_example(project_path)\n"
"          >>> project.network.build_graphs()\n"
"\n"
"          # Mode c is car in this project\n"
"          >>> car_graph = project.network.graphs['c']\n"
"\n"
"          # minimize travel time\n"
"          >>> car_graph.set_graph('free_flow_time')\n"
"\n"
"          # Skims travel time and distance\n"
"          >>> car_graph.set_skimming(['free_flow_time', 'distance'])\n"
"\n"
"          >>> res = SkimResults()\n"
"          >>> res.prepare(car_graph)\n"
"\n"
"          >>> res.skims.export(project_path / \"skim_matrices.omx\")\n"
"\n"
"          >>> project.close()\n"
"    "
msgstr ""
"Titular de resultados de skimming de red.\n"
"\n"
"    .. bloque de código:: python\n"
"\n"
"          >>> desde aequilibrae.paths.results importar SkimResults\n"
"\n"
"          >>> proyecto = crear_ejemplo(ruta_proyecto)\n"
"          >>> proyecto.network.build_graphs()\n"
"\n"
"          # El modo c es un automóvil en este proyecto.\n"
"          >>> car_graph = proyecto.network.graphs['c']\n"
"\n"
"          # minimizar el tiempo de viaje\n"
"          >>> car_graph.set_graph('tiempo_flujo_libre')\n"
"\n"
"          # Omite el tiempo y la distancia de viaje\n"
"          >>> car_graph.set_skimming(['free_flow_time', 'distancia'])\n"
"\n"
"          >>> res = SkimResults()\n"
"          >>> res.preparar(car_graph)\n"
"\n"
"          >>> res.skims.export(ruta_proyecto / \"skim_matrices.omx\")\n"
"\n"
"          >>> proyecto.cerrar()"

#: aequilibrae/project/network/connector_creation.py:372
msgid ""
