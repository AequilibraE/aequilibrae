#: aequilibrae/utils/simwrapper/generate_simwrapper_config.py:1
msgid ""
"Utilities to generate SimWrapper dashboard configuration for an AequilibraE project.\n"
"\n"
"Usage\n"
"-----\n"
".. code-block:: python\n"
"    :caption: Generate SimWrapper dashboard for an open project\n"
"\n"
"    >>> from aequilibrae.project import Project\n"
"    >>> from aequilibrae.utils.simwrapper.generate_simwrapper_config import SimwrapperConfigGenerator\n"
"    >>> prj = Project()\n"
"    >>> prj.open('/path/to/project')\n"
"    >>> gen = SimwrapperConfigGenerator(prj, output_dir='simwrapper')\n"
"    >>> gen.write_yamls()\n"
"\n"
"Notes\n"
"-----\n"
"- `output_dir` must be inside the project directory\n"
msgstr ""
"Utilidades para generar la configuración del panel SimWrapper para un proyecto AequilibraE.\n"
"\n"
"Uso\n"
"-----\n"
".. bloque de código:: python\n"
"    :caption: Genere el panel de SimWrapper para un proyecto abierto\n"
"\n"
"    >>> desde aequilibrae.project importar proyecto\n"
"    >>> desde aequilibrae.utils.simwrapper.generate_simwrapper_config importar SimwrapperConfigGenerator\n"
"    >>> prj = Proyecto()\n"
"    >>> prj.open('/ruta/al/proyecto')\n"
"    >>> gen = SimwrapperConfigGenerator(prj, salida_dir='simwrapper')\n"
"    >>> gen.write_yamls()\n"
"\n"
"Notas\n"
"-----\n"
"- `output_dir` debe estar dentro del directorio del proyecto"

