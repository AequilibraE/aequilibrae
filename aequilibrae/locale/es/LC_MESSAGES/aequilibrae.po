"\n"
"            >>> project = create_example(project_path)\n"
"\n"
"            >>> mat = AequilibraeMatrix()\n"
"            >>> mat.load(Path(project_path) / 'matrices/skims.omx')\n"
"            >>> mat.computational_view([\"distance_blended\"])\n"
"            >>> mat.columns()\n"
