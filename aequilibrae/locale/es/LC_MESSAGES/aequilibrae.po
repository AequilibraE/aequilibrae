"caracteres.\n"
"\n"
"        .. bloque de código:: python\n"
"\n"
"            >>> desde aequilibrae.matrix importar AequilibraeMatrix\n"
"\n"
"            >>> zonas_en_el_modelo = 3317\n"
"\n"
"            >>> mat = AequilibraeMatrix()\n"
"            >>> mat.create_empty(nombre_archivo=Ruta(ruta_mi_carpeta) / 'mi_matriz.aem',\n"
"            ... zonas=zonas_en_el_modelo,\n"
"            ...memoria_solo=Falso)\n"
"            >>> mat.setDescription('Esto es un texto')\n"
"            >>> mat.guardar()\n"
"            >>> mat.cerrar()\n"
"\n"
"            >>> mat = AequilibraeMatrix()\n"
"            >>> mat.load(Ruta(ruta_mi_carpeta) / 'mi_matriz.aem')\n"
"            >>> mat.descripción.decode('utf-8')\n"
"            'Esto es un texto'"

