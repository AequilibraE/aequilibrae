"\n"
"        # Agregar un nuevo campo y guardarlo\n"
"        >>> proyecto.about.add_info_field('mi_super_campo_relevante')\n"
"        >>> project.about.my_super_relevant_field = 'información súper relevante'\n"
"        >>> proyecto.about.write_back()\n"
"\n"
"        # cambiar el valor de un valor/campo existente\n"
