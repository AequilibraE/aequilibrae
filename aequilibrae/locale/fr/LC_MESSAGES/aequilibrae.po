#: aequilibrae/project/network/link_types.py:9
#, python-format
msgid ""
"\n"
"    Access to the API resources to manipulate the link_types table in the network.\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> project = create_example(project_path)\n"
"\n"
"        >>> link_types = project.network.link_types\n"
"\n"
"        # We can get a dictionary of link types in the model\n"
"        >>> all_link_types = link_types.all_types()\n"
"\n"
"        # And do a bulk change and save it\n"
"        >>> for link_type_id, link_type_obj in all_link_types.items():\n"
"        ...     link_type_obj.beta = 1\n"
"\n"
"        # We can save changes for all link types in one go\n"
"        >>> link_types.save()\n"
"\n"
"        # or just get one link_type in specific\n"
"        >>> default_link_type = link_types.get('y')\n"
"\n"
"        # or just get it by name\n"
"        >>> default_link_type = link_types.get_by_name('default')\n"
"\n"
"        # We can change the description of the link types\n"
"        >>> default_link_type.description = 'My own new description'\n"
"\n"
"        # Let's say we are using alpha to store lane capacity during the night as 90% of the standard\n"
"        >>> default_link_type.alpha = 0.9 * default_link_type.lane_capacity\n"
"\n"
"        # To save this link types we can simply\n"
"        >>> default_link_type.save()\n"
"\n"
"        # We can also create a completely new link_type and add to the model\n"
"        >>> new_type = link_types.new('a')\n"
"        >>> new_type.link_type = 'Arterial'  # Only ASCII letters and *_* allowed # other fields are not mandatory\n"
"\n"
"        # We then save it to the database\n"
"        >>> new_type.save()\n"
"\n"
"        # we can even keep editing and save it directly once we have added it to the project\n"
"        >>> new_type.lanes = 3\n"
"        >>> new_type.lane_capacity = 1100\n"
"        >>> new_type.save()\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Accès aux ressources API pour manipuler la table link_types dans le réseau.\n"
"\n"
"    .. bloc de code :: python\n"
"\n"
"        >>> projet = create_example(project_path)\n"
"\n"
"        >>> link_types = projet.network.link_types\n"
"\n"
"        # Nous pouvons obtenir un dictionnaire des types de liens dans le modèle\n"
"        >>> all_link_types = link_types.all_types()\n"
"\n"
"        # Et effectuez une modification groupée et enregistrez-la\n"
"        >>> pour link_type_id, link_type_obj dans all_link_types.items() :\n"
"        ... link_type_obj.beta = 1\n"
"\n"
"        # Nous pouvons enregistrer les modifications pour tous les types de liens en une seule fois\n"
"        >>> link_types.save()\n"
"\n"
"        # ou obtenez simplement un type de lien spécifique\n"
"        >>> default_link_type = link_types.get('y')\n"
"\n"
"        # ou récupérez-le simplement par son nom\n"
"        >>> default_link_type = link_types.get_by_name('default')\n"
"\n"
"        # Nous pouvons changer la description des types de liens\n"
"        >>> default_link_type.description = 'Ma propre nouvelle description'\n"
"\n"
"        # Disons que nous utilisons alpha pour stocker la capacité des voies pendant la nuit à 90 % de la norme\n"
"        >>> default_link_type.alpha = 0,9 * default_link_type.lane_capacity\n"
"\n"
"        # Pour enregistrer ces types de liens, nous pouvons simplement\n"
"        >>> default_link_type.save()\n"
"\n"
"        # Nous pouvons également créer un tout nouveau link_type et l'ajouter au modèle\n"
"        >>> new_type = link_types.new('a')\n"
"        >>> new_type.link_type = 'Arterial' # Seules les lettres ASCII et *_* sont autorisées # les autres champs ne "
"sont pas obligatoires\n"
"\n"
"        # Nous l'enregistrons ensuite dans la base de données\n"
"        >>> new_type.save()\n"
"\n"
"        # nous pouvons même continuer à l'éditer et l'enregistrer directement une fois que nous l'avons ajouté au "
"projet\n"
"        >>> new_type.lanes = 3\n"
"        >>> new_type.lane_capacity = 1100\n"
"        >>> new_type.save()\n"
"\n"
"        >>> projet.close()"

