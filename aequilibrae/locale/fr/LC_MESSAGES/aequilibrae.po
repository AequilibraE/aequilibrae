#: aequilibrae/distribution/gravity_application.py:17
#, python-brace-format
msgid ""
"Applies a synthetic gravity model.\n"
"\n"
"    Model is an instance of SyntheticGravityModel class.\n"
"\n"
"    Impedance is an instance of AequilibraEMatrix.\n"
"\n"
"    Vectors are a pandas DataFrame.\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> import pandas as pd\n"
"        >>> from aequilibrae.distribution import SyntheticGravityModel, GravityApplication\n"
"\n"
"        >>> project = create_example(project_path)\n"
"\n"
"        # We define the model we will use\n"
"        >>> model = SyntheticGravityModel()\n"
"\n"
"        # Before adding a parameter to the model, you need to define the model functional form\n"
"        # You can select one of GAMMA, EXPO or POWER.\n"
"        >>> model.function = \"GAMMA\"\n"
"\n"
"        # Only the parameter(s) applicable to the chosen functional form will have any effect\n"
"        >>> model.alpha = 0.1\n"
"        >>> model.beta = 0.0001\n"
"\n"
"        # We load the impedance matrix\n"
"        >>> matrix = project.matrices.get_matrix(\"skims\")\n"
"        >>> matrix.computational_view([\"distance_blended\"])\n"
"\n"
"        # We create the vectors we will use\n"
"        >>> query = \"SELECT zone_id, population, employment FROM zones;\"\n"
"        >>> with project.db_connection as conn:\n"
"        ...     df = pd.read_sql(query, conn)\n"
"        >>> df.sort_values(by=\"zone_id\", inplace=True)\n"
"        >>> df.set_index(\"zone_id\", inplace=True)\n"
"\n"
"        # You create the vectors you would have\n"
"        >>> df = df.assign(productions=df.population * 3.0)\n"
"        >>> df = df.assign(attractions=df.employment * 4.0)\n"
"        >>> vectors = df[[\"productions\", \"attractions\"]]\n"
"\n"
"        # Balance the vectors\n"
"        >>> vectors.loc[:, \"attractions\"] *= vectors[\"productions\"].sum() / vectors[\"attractions\"].sum()\n"
"\n"
"        # Create the problem object\n"
"        >>> args = {\"impedance\": matrix,\n"
"        ...         \"vectors\": vectors,\n"
"        ...         \"row_field\": \"productions\",\n"
"        ...         \"model\": model,\n"
"        ...         \"column_field\": \"attractions\",\n"
"        ...         \"nan_as_zero\":True\n"
"        ...         }\n"
"        >>> gravity = GravityApplication(**args)\n"
"\n"
"        # Solve and save the outputs\n"
"        >>> gravity.apply()\n"
"        >>> gravity.output.export(project_path / 'matrices' / 'gravity_omx.omx')\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Applique un modèle de gravité synthétique.\n"
"\n"
"    Model est une instance de la classe SyntheticGravityModel.\n"
"\n"
"    L'impédance est une instance d'AequilibraEMatrix.\n"
"\n"
"    Les vecteurs sont un DataFrame pandas.\n"
"\n"
"    .. bloc de code :: python\n"
"\n"
"        >>> importer des pandas au format PD\n"
"        >>> depuis aequilibrae.distribution importer SyntheticGravityModel, GravityApplication\n"
"\n"
"        >>> projet = create_example(project_path)\n"
"\n"
"        # Nous définissons le modèle que nous utiliserons\n"
"        >>> modèle = SyntheticGravityModel()\n"
"\n"
"        # Avant d'ajouter un paramètre au modèle, vous devez définir la forme fonctionnelle du modèle\n"
"        # Vous pouvez sélectionner l'un des GAMMA, EXPO ou POWER.\n"
"        >>> modèle.fonction = \"GAMMA\"\n"
"\n"
"        # Seuls le(s) paramètre(s) applicable(s) à la forme fonctionnelle choisie auront un effet\n"
"        >>> modèle.alpha = 0,1\n"
"        >>> modèle.bêta = 0,0001\n"
"\n"
"        # On charge la matrice d'impédance\n"
"        >>> matrice = project.matrices.get_matrix(\"skims\")\n"
"        >>> matrice.computational_view([\"distance_blended\"])\n"
"\n"
"        # Nous créons les vecteurs que nous utiliserons\n"
"        >>> query = \"SELECT zone_id, population, emploi FROM zones ;\"\n"
"        >>> avec project.db_connection comme connexion :\n"
"        ... df = pd.read_sql(requête, conn)\n"
"        >>> df.sort_values(by=\"zone_id\", inplace=True)\n"
"        >>> df.set_index(\"zone_id\", inplace=True)\n"
"\n"
"        # Vous créez les vecteurs que vous auriez\n"
"        >>> df = df.assign(productions=df.population * 3.0)\n"
"        >>> df = df.assign(attractions=df.employment * 4.0)\n"
"        >>> vecteurs = df[[\"productions\", \"attractions\"]]\n"
"\n"
"        # Équilibrer les vecteurs\n"
"        >>> vecteurs.loc[:, \"attractions\"] *= vecteurs[\"productions\"].sum() / vecteurs[\"attractions\"].sum()\n"
"\n"
"        # Créer l'objet problématique\n"
"        >>> args = {\"impédance\": matrice,\n"
"        ... \"vecteurs\" : vecteurs,\n"
"        ... \"row_field\": \"productions\",\n"
"        ... \"modèle\": modèle,\n"
"        ... \"column_field\": \"attractions\",\n"
"        ... \"nan_as_zero\":Vrai\n"
"        ... }\n"
"        >>> gravité = GravityApplication(**args)\n"
"\n"
"        # Résoudre et enregistrer les sorties\n"
"        >>> gravité.apply()\n"
"        >>> gravitation.output.export(chemin_projet / 'matrices' / 'gravity_omx.omx')\n"
"\n"
"        >>> projet.close()"

