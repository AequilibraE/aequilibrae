#: aequilibrae/project/network/link.py:8
msgid ""
"A Link object represents a single record in the *links* table\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> project = create_example(project_path)\n"
"\n"
"        >>> all_links = project.network.links\n"
"\n"
"        # Let's get a mode to work with\n"
"        >>> modes = project.network.modes\n"
"        >>> car_mode = modes.get('c')\n"
"\n"
"        # We can just get one link in specific\n"
"        >>> link1 = all_links.get(3)\n"
"        >>> link2 = all_links.get(17)\n"
"\n"
"        # We can find out which fields exist for the links\n"
"        >>> which_fields_do_we_have = link1.data_fields()\n"
"\n"
"        # And edit each one like this\n"
"        >>> link1.lanes_ab = 3\n"
"        >>> link1.lanes_ba = 2\n"
"\n"
"        # we can drop a mode from the link\n"
"        >>> link1.drop_mode(car_mode)  # or link1.drop_mode('c')\n"
"\n"
"        # we can add a mode to the link\n"
"        >>> link2.add_mode(car_mode)  # or link2.add_mode('c')\n"
"\n"
"        # Or set all modes at once\n"
"        >>> link2.set_modes('cbtw')\n"
"\n"
"        # We can just save the link\n"
"        >>> link1.save()\n"
"        >>> link2.save()\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Un objet Link représente un seul enregistrement dans la table *links*\n"
"\n"
"    .. bloc de code :: python\n"
"\n"
"        >>> projet = create_example(project_path)\n"
"\n"
"        >>> all_links = projet.network.links\n"
"\n"
"        # Trouvons un mode avec lequel travailler\n"
"        >>> modes = projet.network.modes\n"
"        >>> car_mode = modes.get('c')\n"
"\n"
"        # Nous pouvons simplement obtenir un lien en particulier\n"
"        >>> lien1 = all_links.get(3)\n"
"        >>> lien2 = all_links.get(17)\n"
"\n"
"        # On peut savoir quels champs existent pour les liens\n"
"        >>> which_fields_do_we_have = link1.data_fields()\n"
"\n"
"        # Et éditez chacun comme ceci\n"
"        >>> lien1.lanes_ab = 3\n"
"        >>> lien1.lanes_ba = 2\n"
"\n"
"        # nous pouvons supprimer un mode à partir du lien\n"
"        >>> link1.drop_mode(car_mode) # ou link1.drop_mode('c')\n"
"\n"
"        # on peut ajouter un mode au lien\n"
"        >>> link2.add_mode(car_mode) # ou link2.add_mode('c')\n"
"\n"
"        # Ou définir tous les modes à la fois\n"
"        >>> link2.set_modes('cbtw')\n"
"\n"
"        # Nous pouvons simplement enregistrer le lien\n"
"        >>> lien1.save()\n"
"        >>> lien2.save()\n"
"\n"
"        >>> projet.close()"

#: aequilibrae/project/network/node.py:10
msgid ""
"A Node object represents a single record in the *nodes* table\n"
