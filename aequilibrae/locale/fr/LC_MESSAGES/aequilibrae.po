"    .. code-block:: python\n"
"\n"
"        >>> from aequilibrae.paths.results import PathResults\n"
"\n"
"        >>> project = create_example(project_path)\n"
"        >>> project.network.build_graphs()\n"
"\n"
"        # Mode c is car in this project\n"
"        >>> car_graph = project.network.graphs['c']\n"
"\n"
"        # minimize distance\n"
"        >>> car_graph.set_graph('distance')\n"
"\n"
"        # If you want to compute skims\n"
"        # It does increase path computation time substantially\n"
"        >>> car_graph.set_skimming(['distance', 'free_flow_time'])\n"
"\n"
"        >>> res = PathResults()\n"
"        >>> res.prepare(car_graph)\n"
"        >>> res.compute_path(1, 17)\n"
"\n"
"        # Update all the outputs mentioned above for destination 9. Same origin: 1\n"
"        >>> res.update_trace(9)\n"
"\n"
"        # clears all computation results\n"
"        >>> res.reset()\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Détenteur du résultat du calcul du chemin\n"
"\n"
"    .. bloc de code :: python\n"
"\n"
"        >>> depuis aequilibrae.paths.results importer PathResults\n"
"\n"
"        >>> projet = create_example(project_path)\n"
"        >>> project.network.build_graphs()\n"
"\n"
"        # Le mode c est la voiture dans ce projet\n"
"        >>> car_graph = project.network.graphs['c']\n"
"\n"
"        # minimiser la distance\n"
"        >>> car_graph.set_graph('distance')\n"
"\n"
"        # Si vous souhaitez calculer des survols\n"
"        # Cela augmente considérablement le temps de calcul du chemin\n"
"        >>> car_graph.set_skimming(['distance', 'free_flow_time'])\n"
"\n"
"        >>> res = CheminRésultats()\n"
"        >>> res.prepare(car_graph)\n"
"        >>> res.compute_path(1, 17)\n"
"\n"
"        # Mettre à jour toutes les sorties mentionnées ci-dessus pour la destination 9. Même origine : 1\n"
"        >>> res.update_trace(9)\n"
"\n"
"        # efface tous les résultats du calcul\n"
"        >>> res.reset()\n"
"\n"
"        >>> projet.close()"

