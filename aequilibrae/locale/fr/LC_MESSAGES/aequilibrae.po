"\n"
"        # Ajouter un nouveau champ et l'enregistrer\n"
"        >>> project.about.add_info_field('my_super_relevant_field')\n"
"        >>> project.about.my_super_relevant_field = 'informations super pertinentes'\n"
"        >>> projet.about.write_back()\n"
"\n"
"        # changer la valeur d'une valeur/d'un champ existant\n"
"        >>> project.about.scenario_name = 'Juste un meilleur nom de scénario'\n"
