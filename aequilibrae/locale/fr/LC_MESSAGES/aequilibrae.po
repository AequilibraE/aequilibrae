#: aequilibrae/paths/traffic_assignment.py:179
#, python-brace-format
msgid ""
"Traffic assignment class.\n"
"\n"
"    For a comprehensive example on use, see the Use examples page.\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> from aequilibrae.paths import TrafficAssignment, TrafficClass\n"
"\n"
"        >>> project = create_example(project_path)\n"
"        >>> project.network.build_graphs()\n"
"\n"
"        >>> graph = project.network.graphs['c'] # we grab the graph for cars\n"
"        >>> graph.set_graph('free_flow_time') # let's say we want to minimize time\n"
"        >>> graph.set_skimming(['free_flow_time', 'distance']) # And will skim time and distance\n"
"        >>> graph.set_blocked_centroid_flows(True)\n"
"\n"
"        >>> proj_matrices = project.matrices\n"
"\n"
"        >>> demand = proj_matrices.get_matrix(\"demand_omx\")\n"
"\n"
"        # We will only assign one user class stored as 'matrix' inside the OMX file\n"
"        >>> demand.computational_view(['matrix'])\n"
"\n"
"        # Creates the assignment class\n"
"        >>> assigclass = TrafficClass(\"car\", graph, demand)\n"
"\n"
"        >>> assig = TrafficAssignment()\n"
"\n"
"        # The first thing to do is to add at list of traffic classes to be assigned\n"
"        >>> assig.set_classes([assigclass])\n"
"\n"
"        # Then we set the volume delay function\n"
"        >>> assig.set_vdf(\"BPR\")  # This is not case-sensitive\n"
"\n"
"        # And its parameters\n"
"        >>> assig.set_vdf_parameters({\"alpha\": \"b\", \"beta\": \"power\"})\n"
"\n"
"        # The capacity and free flow travel times as they exist in the graph\n"
"        >>> assig.set_capacity_field(\"capacity\")\n"
"        >>> assig.set_time_field(\"free_flow_time\")\n"
"\n"
"        # And the algorithm we want to use to assign\n"
"        >>> assig.set_algorithm('bfw')\n"
"\n"
"        >>> assig.max_iter = 10\n"
"        >>> assig.rgap_target = 0.00001\n"
"\n"
"        >>> assig.execute() # we then execute the assignment\n"
"\n"
"        # If you want, it is possible to access the convergence report\n"
"        >>> convergence_report = pd.DataFrame(assig.assignment.convergence_report)\n"
"\n"
"        # Assignment results can be viewed as a Pandas DataFrame\n"
"        >>> results_df = assig.results()\n"
"\n"
"        # Information on the assignment setup can be recovered with\n"
"        >>> info = assig.info()\n"
"\n"
"        # Or save it directly to the results database\n"
"        >>> results = assig.save_results(table_name='base_year_assignment')\n"
"\n"
"        # skims are here\n"
"        >>> avg_skims = assigclass.results.skims # blended ones\n"
"        >>> last_skims = assigclass._aon_results.skims # those for the last iteration\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Classe d'affectation du trafic.\n"
"\n"
"    Pour un exemple complet d’utilisation, consultez la page Exemples d’utilisation.\n"
"\n"
"    .. bloc de code :: python\n"
"\n"
"        >>> à partir de aequilibrae.paths, importez TrafficAssignment, TrafficClass\n"
"\n"
"        >>> projet = create_example(project_path)\n"
"        >>> project.network.build_graphs()\n"
"\n"
"        >>> graph = project.network.graphs['c'] # on récupère le graphique pour les voitures\n"
"        >>> graph.set_graph('free_flow_time') # disons que nous voulons minimiser le temps\n"
"        >>> graph.set_skimming(['free_flow_time', 'distance']) # Et parcourra le temps et la distance\n"
"        >>> graph.set_blocked_centroid_flows(Vrai)\n"
"\n"
"        >>> proj_matrices = projet.matrices\n"
"\n"
"        >>> demande = proj_matrices.get_matrix(\"demand_omx\")\n"
"\n"
"        # Nous n'attribuerons qu'une seule classe d'utilisateurs stockée comme 'matrice' dans le fichier OMX\n"
"        >>> demand.computational_view(['matrice'])\n"
"\n"
"        # Crée la classe d'affectation\n"
"        >>> assigclass = TrafficClass(\"voiture\", graphique, demande)\n"
"\n"
"        >>> assig = TrafficAssignment()\n"
"\n"
"        # La première chose à faire est d'ajouter une liste de classes de trafic à attribuer\n"
"        >>> assig.set_classes([assigclass])\n"
"\n"
"        # Ensuite, nous définissons la fonction de retard de volume\n"
"        >>> assig.set_vdf(\"BPR\") # Ce n'est pas sensible à la casse\n"
"\n"
"        # Et ses paramètres\n"
"        >>> assig.set_vdf_parameters({\"alpha\": \"b\", \"beta\": \"puissance\"})\n"
"\n"
"        # La capacité et les temps de parcours en flux libre tels qu'ils existent dans le graphique\n"
"        >>> assig.set_capacity_field(\"capacité\")\n"
"        >>> assig.set_time_field(\"free_flow_time\")\n"
"\n"
"        # Et l'algorithme que nous voulons utiliser pour attribuer\n"
"        >>> assig.set_algorithm('bfw')\n"
"\n"
"        >>> assig.max_iter = 10\n"
"        >>> assig.rgap_target = 0,00001\n"
"\n"
"        >>> assig.execute() # nous exécutons ensuite la mission\n"
"\n"
"        # Si vous le souhaitez, il est possible d'accéder au rapport de convergence\n"
"        >>> convergence_report = pd.DataFrame(assig.assignment.convergence_report)\n"
"\n"
"        # Les résultats de l'affectation peuvent être visualisés sous forme de Pandas DataFrame\n"
"        >>> results_df = assig.results()\n"
"\n"
"        # Les informations sur la configuration de l'affectation peuvent être récupérées avec\n"
"        >>> info = assig.info()\n"
"\n"
"        # Ou enregistrez-le directement dans la base de données des résultats\n"
"        >>> résultats = assig.save_results(table_name='base_year_assignment')\n"
"\n"
"        # survols sont ici\n"
"        >>> avg_skims = assigclass.results.skims # ceux mélangés\n"
"        >>> last_skims = assigclass._aon_results.skims # ceux de la dernière itération\n"
"\n"
"        >>> projet.close()"

#: aequilibrae/paths/traffic_assignment.py:356
msgid "Traffic class already in the assignment"
msgstr "Classe de trafic déjà dans la mission"

#: aequilibrae/paths/traffic_class.py:67
msgid ""
"Traffic class for equilibrium traffic assignment\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> from aequilibrae.paths import TrafficClass\n"
"\n"
"        >>> project = create_example(project_path)\n"
"        >>> project.network.build_graphs()\n"
"\n"
"        >>> graph = project.network.graphs['c'] # we grab the graph for cars\n"
"        >>> graph.set_graph('free_flow_time') # let's say we want to minimize time\n"
"        >>> graph.set_skimming(['free_flow_time', 'distance']) # And will skim time and distance\n"
"        >>> graph.set_blocked_centroid_flows(False)\n"
"\n"
"        >>> proj_matrices = project.matrices\n"
"\n"
"        >>> demand = proj_matrices.get_matrix(\"demand_omx\")\n"
"        >>> demand.computational_view()\n"
"\n"
"        >>> tc = TrafficClass(\"car\", graph, demand)\n"
"        >>> tc.set_pce(1.3)\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Classe de trafic pour l'affectation du trafic à l'équilibre\n"
"\n"
"    .. bloc de code :: python\n"
"\n"
"        >>> à partir d'aequilibrae.paths, importez TrafficClass\n"
"\n"
"        >>> projet = create_example(project_path)\n"
"        >>> project.network.build_graphs()\n"
"\n"
"        >>> graph = project.network.graphs['c'] # on récupère le graphique pour les voitures\n"
"        >>> graph.set_graph('free_flow_time') # disons que nous voulons minimiser le temps\n"
"        >>> graph.set_skimming(['free_flow_time', 'distance']) # Et parcourra le temps et la distance\n"
"        >>> graph.set_blocked_centroid_flows(False)\n"
"\n"
"        >>> proj_matrices = projet.matrices\n"
"\n"
"        >>> demande = proj_matrices.get_matrix(\"demand_omx\")\n"
"        >>> demande.computational_view()\n"
"\n"
"        >>> tc = TrafficClass(\"voiture\", graphique, demande)\n"
"        >>> tc.set_pce(1.3)\n"
"\n"
"        >>> projet.close()"

