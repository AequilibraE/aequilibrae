#: aequilibrae/paths/connectivity_analysis.py:13
msgid ""
"\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> from aequilibrae.paths.connectivity_analysis import ConnectivityAnalysis\n"
"\n"
"        >>> project = create_example(project_path)\n"
"\n"
"        >>> network = project.network\n"
"        >>> network.build_graphs()\n"
"\n"
"        >>> graph = network.graphs['c']\n"
"        >>> graph.set_graph(cost_field=\"distance\")\n"
"        >>> graph.set_blocked_centroid_flows(False)\n"
"\n"
"        >>> conn_test = ConnectivityAnalysis(graph)\n"
"        >>> conn_test.execute()\n"
"\n"
"        # The connectivity tester report as a Pandas DataFrame\n"
"        >>> disconnected = conn_test.disconnected_pairs\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
".. bloc de code :: python\n"
"\n"
"        >>> depuis aequilibrae.paths.connectivity_analysis importer ConnectivityAnalysis\n"
"\n"
"        >>> projet = create_example(project_path)\n"
"\n"
"        >>> réseau = projet.réseau\n"
"        >>> réseau.build_graphs()\n"
"\n"
"        >>> graphique = réseau.graphs['c']\n"
"        >>> graph.set_graph(cost_field=\"distance\")\n"
"        >>> graph.set_blocked_centroid_flows(False)\n"
"\n"
"        >>> conn_test = ConnectivitéAnalyse (graphique)\n"
"        >>> conn_test.execute()\n"
"\n"
"        # Le rapport du testeur de connectivité sous forme de Pandas DataFrame\n"
"        >>> déconnecté = conn_test.disconnected_pairs\n"
"\n"
"        >>> projet.close()"

#: aequilibrae/paths/network_skimming.py:21
msgid ""
"\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> from aequilibrae.paths.network_skimming import NetworkSkimming\n"
"\n"
"        >>> project = create_example(project_path)\n"
"        >>> project.network.build_graphs(modes=[\"c\"])\n"
"\n"
"        >>> graph = project.network.graphs['c']\n"
"        >>> graph.set_graph(\"distance\")\n"
"        >>> graph.set_skimming(\"distance\")\n"
"\n"
"        >>> skm = NetworkSkimming(graph)\n"
"        >>> skm.execute()\n"
"\n"
"        # The skim report (if any error generated) is available here\n"
"        >>> skm.report\n"
"        []\n"
"\n"
"        # To access the skim matrix directly from its temporary file\n"
"        >>> matrix = skm.results.skims\n"
"\n"
"        # Or you can save the results to disk\n"
"        >>> skm.save_to_project('skimming_result_omx', 'omx')\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
".. bloc de code :: python\n"
"\n"
"        >>> depuis aequilibrae.paths.network_skimming importer NetworkSkimming\n"
"\n"
"        >>> projet = create_example(project_path)\n"
"        >>> project.network.build_graphs(modes=[\"c\"])\n"
"\n"
"        >>> graphique = project.network.graphs['c']\n"
"        >>> graph.set_graph(\"distance\")\n"
"        >>> graph.set_skimming(\"distance\")\n"
"\n"
"        >>> skm = NetworkSkimming (graphique)\n"
"        >>> skm.execute()\n"
"\n"
"        # Le rapport d'écrémage (si une erreur est générée) est disponible ici\n"
"        >>> skm.rapport\n"
"        []\n"
"\n"
"        # Pour accéder à la matrice de survol directement depuis son fichier temporaire\n"
"        >>> matrice = skm.results.skims\n"
"\n"
"        # Ou vous pouvez enregistrer les résultats sur le disque\n"
"        >>> skm.save_to_project('skimming_result_omx', 'omx')\n"
"\n"
"        >>> projet.close()"

