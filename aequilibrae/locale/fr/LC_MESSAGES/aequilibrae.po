#: aequilibrae/project/network/modes.py:8
msgid ""
"\n"
"    Access to the API resources to manipulate the modes table in the network\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> project = create_example(project_path)\n"
"\n"
"        >>> modes = project.network.modes\n"
"\n"
"        # We can get a dictionary of all modes in the model\n"
"        >>> all_modes = modes.all_modes()\n"
"\n"
"        # And do a bulk change and save it\n"
"        >>> for mode_id, mode_obj in all_modes.items():\n"
"        ...     mode_obj.beta = 1\n"
"        ...     mode_obj.save()\n"
"\n"
"        # or just get one mode in specific\n"
"        >>> car_mode = modes.get('c')\n"
"\n"
"        # or just get this same mode by name\n"
"        >>> car_mode = modes.get_by_name('car')\n"
"\n"
"        # We can change the description of the mode\n"
"        >>> car_mode.description = 'personal autos only'\n"
"\n"
"        # Let's say we are using alpha to store the PCE for a future year with much smaller cars\n"
"        >>> car_mode.alpha = 0.95\n"
"\n"
"        # To save this mode we can simply\n"
"        >>> car_mode.save()\n"
"\n"
"        # We can also create a completely new mode and add to the model\n"
"        >>> new_mode = modes.new('k')\n"
"        >>> new_mode.mode_name = 'flying_car'  # Only ASCII letters and *_* allowed # other fields are not mandatory\n"
"\n"
"        # We then explicitly add it to the network\n"
"        >>> modes.add(new_mode)\n"
"\n"
"        # we can even keep editing and save it directly once we have added it to the project\n"
"        >>> new_mode.description = 'this is my new description'\n"
"        >>> new_mode.save()\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Accès aux ressources API pour manipuler la table des modes dans le réseau\n"
"\n"
"    .. bloc de code :: python\n"
"\n"
"        >>> projet = create_example(project_path)\n"
"\n"
"        >>> modes = projet.network.modes\n"
"\n"
"        # Nous pouvons obtenir un dictionnaire de tous les modes du modèle\n"
"        >>> all_modes = modes.all_modes()\n"
"\n"
"        # Et effectuez une modification groupée et enregistrez-la\n"
"        >>> pour mode_id, mode_obj dans all_modes.items() :\n"
"        ... mode_obj.bêta = 1\n"
"        ... mode_obj.save()\n"
"\n"
"        # ou obtenez simplement un mode en particulier\n"
"        >>> car_mode = modes.get('c')\n"
"\n"
"        # ou obtenez simplement ce même mode par son nom\n"
"        >>> car_mode = modes.get_by_name('voiture')\n"
"\n"
"        # On peut changer la description du mode\n"
"        >>> car_mode.description = 'voitures personnelles uniquement'\n"
"\n"
"        # Disons que nous utilisons alpha pour stocker le PCE pour une année future avec des voitures beaucoup plus "
"petites\n"
"        >>> car_mode.alpha = 0,95\n"
"\n"
"        # Pour sauvegarder ce mode on peut simplement\n"
"        >>> car_mode.save()\n"
"\n"
"        # Nous pouvons également créer un tout nouveau mode et l'ajouter au modèle\n"
"        >>> new_mode = modes.new('k')\n"
"        >>> new_mode.mode_name = 'flying_car' # Seules les lettres ASCII et *_* sont autorisées # les autres champs "
"ne sont pas obligatoires\n"
"\n"
"        # Nous l'ajoutons ensuite explicitement au réseau\n"
"        >>> modes.add(new_mode)\n"
"\n"
"        # nous pouvons même continuer à l'éditer et l'enregistrer directement une fois que nous l'avons ajouté au "
"projet\n"
"        >>> new_mode.description = 'voici ma nouvelle description'\n"
"        >>> new_mode.save()\n"
"\n"
"        >>> projet.close()"

