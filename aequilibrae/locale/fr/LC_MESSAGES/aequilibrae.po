#: aequilibrae/transit/transit_elements/route.py:8
msgid ""
"Transit route element to feed into Transit_routes\n"
"\n"
"    * route_id (:obj:`str`): ID of this route, starting with the agency prefix ID\n"
"    * route_short_name (:obj:`str`): Short name as found in the GTFS feed\n"
"    * route_long_name (:obj:`str`): Long name as found in the GTFS feed\n"
"    * route_desc (:obj:`str`): Route description as found in the GTFS feed\n"
"    * route_type (:obj:`int`):  Route type (mode) for this transit link\n"
"    * route_url (:obj:`str`): Route URL as found in the GTFS feed\n"
"    * route_color (:obj:`str`): Route color for mapping as found in the GTFS feed\n"
"    * route_text_color (:obj:`str`): Route color (text) for mapping as found in the GTFS feed\n"
"    * route_sort_order (:obj:`int`): Route rendering order as found in the GTFS feed\n"
"    * agency_id (:obj:`str`): Agency ID\n"
"    * pce (:obj:`float`): Vehicle PCE for this route\n"
"    * seated_capacity (:obj:`float`): Vehicle seated capacity for this route\n"
"    * total_capacity (:obj:`float`): Total vehicle capacity for this route"
msgstr ""
"Élément d'itinéraire de transit à alimenter dans Transit_routes\n"
"\n"
"    * route_id (:obj:`str`) : ID de cette route, commençant par l'ID du préfixe de l'agence\n"
"    * route_short_name (:obj:`str`) : nom court tel que trouvé dans le flux GTFS\n"
"    * route_long_name (:obj:`str`) : nom long tel que trouvé dans le flux GTFS\n"
"    * route_desc (:obj:`str`) : description de l'itinéraire telle que trouvée dans le flux GTFS\n"
"    * route_type (:obj:`int`) : type de route (mode) pour cette liaison de transit\n"
"    * route_url (:obj:`str`) : URL de route telle que trouvée dans le flux GTFS\n"
"    * route_color (:obj:`str`) : couleur de la route pour le mappage telle que trouvée dans le flux GTFS\n"
"    * route_text_color (:obj:`str`) : couleur de la route (texte) pour le mappage tel que trouvé dans le flux GTFS\n"
"    * route_sort_order (:obj:`int`) : ordre de rendu des routes tel que trouvé dans le flux GTFS\n"
"    * Agency_id (:obj:`str`) : ID de l'agence\n"
"    * pce (:obj:`float`) : PCE du véhicule pour cet itinéraire\n"
"    * sited_capacity (:obj:`float`) : capacité du véhicule en places assises pour cet itinéraire\n"
"    * total_capacity (:obj:`float`) : capacité totale des véhicules pour cet itinéraire"

#: aequilibrae/transit/transit_elements/service.py:5
msgid ""
"Transit service built with data from calendar.txt and calendar_dates.txt from GTFS\n"
"\n"
"    * service_id (:obj:`str`):\n"
"    * monday (:obj:`int`): Flag if the route runs on mondays (1 for **True**, 0 for **False**)\n"
"    * tuesday (:obj:`int`): Flag if the route runs on tuesdays (1 for **True**, 0 for **False**)\n"
"    * wednesday (:obj:`int`): Flag if the route runs on wednesdays (1 for **True**, 0 for **False**)\n"
"    * thursday (:obj:`int`): Flag if the route runs on thursdays (1 for **True**, 0 for **False**)\n"
"    * friday (:obj:`int`): Flag if the route runs on fridays (1 for **True**, 0 for **False**)\n"
"    * saturday (:obj:`int`): Flag if the route runs on saturdays (1 for **True**, 0 for **False**)\n"
"    * sunday (:obj:`int`): Flag if the route runs on sundays (1 for **True**, 0 for **False**)\n"
"    * start_date (:obj:`str`): Start date for this service\n"
"    * end_date (:obj:`str`): End date for this service\n"
"    * dates (:obj:`List[str]`): List of all dates for which this service is active between its start and end dates\n"
"    "
msgstr ""
"Service de transport en commun construit avec les données de Calendar.txt et Calendar_dates.txt de GTFS\n"
"\n"
"    * service_id (:obj:`str`) :\n"
"    * monday (:obj:`int`) : indicateur si l'itinéraire fonctionne le lundi (1 pour **True**, 0 pour **False**)\n"
"    * mardi (:obj:`int`) : indicateur si l'itinéraire circule le mardi (1 pour **True**, 0 pour **False**)\n"
"    * mercredi (:obj:`int`) : indicateur si la route circule le mercredi (1 pour **Vrai**, 0 pour **False**)\n"
"    * jeudi (:obj:`int`) : indicateur si l'itinéraire circule le jeudi (1 pour **Vrai**, 0 pour **False**)\n"
"    * vendredi (:obj:`int`) : indicateur si l'itinéraire circule le vendredi (1 pour **True**, 0 pour **False**)\n"
"    * samedi (:obj:`int`) : indicateur si l'itinéraire circule le samedi (1 pour **True**, 0 pour **False**)\n"
"    * dimanche (:obj:`int`) : indicateur si l'itinéraire circule le dimanche (1 pour **True**, 0 pour **False**)\n"
"    * start_date (:obj:`str`) : date de début de ce service\n"
"    * end_date (:obj:`str`) : Date de fin de ce service\n"
"    * dates (:obj:`List[str]`) : Liste de toutes les dates pour lesquelles ce service est actif entre ses dates de "
"début et de fin"

