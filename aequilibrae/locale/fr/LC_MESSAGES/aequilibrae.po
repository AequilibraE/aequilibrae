#: aequilibrae/distribution/gravity_calibration.py:19
#, python-brace-format
msgid ""
"Calibrate a traditional gravity model\n"
"\n"
"    Available deterrence function forms are: 'EXPO', 'POWER' or 'GAMMA'.\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> from aequilibrae.distribution import GravityCalibration\n"
"\n"
"        >>> project = create_example(project_path)\n"
"\n"
"        # We load the demand matrix\n"
"        >>> demand = project.matrices.get_matrix(\"demand_omx\")\n"
"        >>> demand.computational_view()\n"
"\n"
"        # We load the skim matrix\n"
"        >>> skim = project.matrices.get_matrix(\"skims\")\n"
"        >>> skim.computational_view([\"time_final\"])\n"
"\n"
"        >>> args = {\"matrix\": demand,\n"
"        ...         \"impedance\": skim,\n"
"        ...         \"row_field\": \"productions\",\n"
"        ...         \"function\": 'expo',\n"
"        ...         \"nan_as_zero\": True}\n"
"        >>> gravity = GravityCalibration(**args)\n"
"\n"
"        # Solve and save outputs\n"
"        >>> gravity.calibrate()\n"
"        >>> gravity.model.save(project_path / 'dist_expo_model.mod')\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Calibrer un modèle gravitationnel traditionnel\n"
"\n"
"    Les formes de fonction de dissuasion disponibles sont : « EXPO », « POWER » ou « GAMMA ».\n"
"\n"
"    .. bloc de code :: python\n"
"\n"
"        >>> depuis aequilibrae.distribution importer GravityCalibration\n"
"\n"
"        >>> projet = create_example(project_path)\n"
"\n"
"        # On charge la matrice de demande\n"
"        >>> demande = project.matrices.get_matrix(\"demand_omx\")\n"
"        >>> demande.computational_view()\n"
"\n"
"        # On charge la matrice de survol\n"
"        >>> écrémé = project.matrices.get_matrix(\"écrémé\")\n"
"        >>> skim.computational_view([\"time_final\"])\n"
"\n"
"        >>> args = {\"matrice\": demande,\n"
"        ... \"impédance\" : écrémer,\n"
"        ... \"row_field\": \"productions\",\n"
"        ... \"fonction\": 'expo',\n"
"        ... \"nan_as_zero\": Vrai}\n"
"        >>> gravité = GravityCalibration(**args)\n"
"\n"
"        # Résoudre et enregistrer les sorties\n"
"        >>> gravité.calibrate()\n"
"        >>> gravitation.model.save(project_path / 'dist_expo_model.mod')\n"
"\n"
"        >>> projet.close()"

