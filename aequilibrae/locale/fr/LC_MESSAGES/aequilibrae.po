"\n"
"        # We can just get one link in specific\n"
"        >>> node1 = all_nodes.get(7)\n"
"\n"
"        # We can find out which fields exist for the links\n"
"        >>> which_fields_do_we_have = node1.data_fields()\n"
"\n"
"        # It success if the node_id already does not exist\n"
"        >>> node1.renumber(998877)\n"
"\n"
"        >>> node1.geometry = Point(1,2)\n"
"\n"
"        # We can just save the node\n"
"        >>> node1.save()\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Un objet Node représente un seul enregistrement dans la table *nodes*\n"
"\n"
"    .. bloc de code :: python\n"
"\n"
"        >>> à partir du point d'importation shapely.geometry\n"
"\n"
"        >>> projet = create_example(project_path)\n"
"\n"
"        >>> all_nodes = projet.network.nodes\n"
"\n"
"        # Nous pouvons simplement obtenir un lien en particulier\n"
"        >>> noeud1 = all_nodes.get(7)\n"
"\n"
"        # On peut savoir quels champs existent pour les liens\n"
"        >>> which_fields_do_we_have = node1.data_fields()\n"
"\n"
"        # C'est un succès si le node_id n'existe déjà pas\n"
"        >>> node1.rennumber(998877)\n"
"\n"
"        >>> node1.geometry = Point(1,2)\n"
"\n"
"        # On peut simplement sauvegarder le nœud\n"
"        >>> node1.save()\n"
"\n"
"        >>> projet.close()"

