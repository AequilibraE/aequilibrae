#: aequilibrae/distribution/gravity_calibration.py:19
#, python-brace-format
msgid ""
"Calibrate a traditional gravity model\n"
"\n"
"    Available deterrence function forms are: 'EXPO', 'POWER' or 'GAMMA'.\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> from aequilibrae.distribution import GravityCalibration\n"
"\n"
"        >>> project = create_example(project_path)\n"
"\n"
"        # We load the demand matrix\n"
"        >>> demand = project.matrices.get_matrix(\"demand_omx\")\n"
"        >>> demand.computational_view()\n"
"\n"
"        # We load the skim matrix\n"
"        >>> skim = project.matrices.get_matrix(\"skims\")\n"
"        >>> skim.computational_view([\"time_final\"])\n"
"\n"
"        >>> args = {\"matrix\": demand,\n"
"        ...         \"impedance\": skim,\n"
"        ...         \"row_field\": \"productions\",\n"
"        ...         \"function\": 'expo',\n"
"        ...         \"nan_as_zero\": True}\n"
"        >>> gravity = GravityCalibration(**args)\n"
"\n"
"        # Solve and save outputs\n"
"        >>> gravity.calibrate()\n"
"        >>> gravity.model.save(project_path / 'dist_expo_model.mod')\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Calibrar um modelo gravitacional tradicional\n"
"\n"
"    As formas de função de dissuasão disponíveis são: 'EXPO', 'POWER' ou 'GAMMA'.\n"
"\n"
"    .. bloco de código :: python\n"
"\n"
"        >>> de aequilibrae.distribution importar GravityCalibration\n"
"\n"
"        >>> projeto = create_example(project_path)\n"
"\n"
"        # Carregamos a matriz de demanda\n"
"        >>> demanda = project.matrices.get_matrix(\"demand_omx\")\n"
"        >>> demanda.computational_view()\n"
"\n"
"        # Carregamos a matriz skim\n"
"        >>> desnatar = project.matrices.get_matrix(\"desnatar\")\n"
"        >>> skim.computational_view([\"tempo_final\"])\n"
"\n"
"        >>> args = {\"matriz\": demanda,\n"
"        ... \"impedância\": desnatado,\n"
"        ... \"row_field\": \"produções\",\n"
"        ... \"função\": 'expo',\n"
"        ... \"nan_as_zero\": Verdadeiro}\n"
"        >>> gravidade = GravityCalibration(**args)\n"
"\n"
"        # Resolva e salve as saídas\n"
"        >>> gravidade.calibrate()\n"
"        >>> gravidade.model.save(project_path / 'dist_expo_model.mod')\n"
"\n"
"        >>> projeto.close()"

