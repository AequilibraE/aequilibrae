#: aequilibrae/distribution/gravity_application.py:17
#, python-brace-format
msgid ""
"Applies a synthetic gravity model.\n"
"\n"
"    Model is an instance of SyntheticGravityModel class.\n"
"\n"
"    Impedance is an instance of AequilibraEMatrix.\n"
"\n"
"    Vectors are a pandas DataFrame.\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> import pandas as pd\n"
"        >>> from aequilibrae.distribution import SyntheticGravityModel, GravityApplication\n"
"\n"
"        >>> project = create_example(project_path)\n"
"\n"
"        # We define the model we will use\n"
"        >>> model = SyntheticGravityModel()\n"
"\n"
"        # Before adding a parameter to the model, you need to define the model functional form\n"
"        # You can select one of GAMMA, EXPO or POWER.\n"
"        >>> model.function = \"GAMMA\"\n"
"\n"
"        # Only the parameter(s) applicable to the chosen functional form will have any effect\n"
"        >>> model.alpha = 0.1\n"
"        >>> model.beta = 0.0001\n"
"\n"
"        # We load the impedance matrix\n"
"        >>> matrix = project.matrices.get_matrix(\"skims\")\n"
"        >>> matrix.computational_view([\"distance_blended\"])\n"
"\n"
"        # We create the vectors we will use\n"
"        >>> query = \"SELECT zone_id, population, employment FROM zones;\"\n"
"        >>> with project.db_connection as conn:\n"
"        ...     df = pd.read_sql(query, conn)\n"
"        >>> df.sort_values(by=\"zone_id\", inplace=True)\n"
"        >>> df.set_index(\"zone_id\", inplace=True)\n"
"\n"
"        # You create the vectors you would have\n"
"        >>> df = df.assign(productions=df.population * 3.0)\n"
"        >>> df = df.assign(attractions=df.employment * 4.0)\n"
"        >>> vectors = df[[\"productions\", \"attractions\"]]\n"
"\n"
"        # Balance the vectors\n"
"        >>> vectors.loc[:, \"attractions\"] *= vectors[\"productions\"].sum() / vectors[\"attractions\"].sum()\n"
"\n"
"        # Create the problem object\n"
"        >>> args = {\"impedance\": matrix,\n"
"        ...         \"vectors\": vectors,\n"
"        ...         \"row_field\": \"productions\",\n"
"        ...         \"model\": model,\n"
"        ...         \"column_field\": \"attractions\",\n"
"        ...         \"nan_as_zero\":True\n"
"        ...         }\n"
"        >>> gravity = GravityApplication(**args)\n"
"\n"
"        # Solve and save the outputs\n"
"        >>> gravity.apply()\n"
"        >>> gravity.output.export(project_path / 'matrices' / 'gravity_omx.omx')\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Aplica um modelo de gravidade sintética.\n"
"\n"
"    Model é uma instância da classe SyntheticGravityModel.\n"
"\n"
"    Impedância é uma instância de AequilibraEMatrix.\n"
"\n"
"    Os vetores são um DataFrame do pandas.\n"
"\n"
"    .. bloco de código :: python\n"
"\n"
"        >>> importar pandas como pd\n"
"        >>> de aequilibrae.distribution importar SyntheticGravityModel, GravityApplication\n"
"\n"
"        >>> projeto = create_example(project_path)\n"
"\n"
"        # Definimos o modelo que usaremos\n"
"        >>> modelo = SyntheticGravityModel()\n"
"\n"
"        # Antes de adicionar um parâmetro ao modelo, você precisa definir a forma funcional do modelo\n"
"        # Você pode selecionar GAMMA, EXPO ou POWER.\n"
"        >>> modelo.function = \"GAMA\"\n"
"\n"
"        # Somente o(s) parâmetro(s) aplicáveis à forma funcional escolhida terão algum efeito\n"
"        >>> modelo.alpha = 0,1\n"
"        >>> modelo.beta = 0,0001\n"
"\n"
"        # Carregamos a matriz de impedância\n"
"        >>> matriz = project.matrices.get_matrix(\"desnatados\")\n"
"        >>> matriz.computational_view([\"distância_combinada\"])\n"
"\n"
"        # Criamos os vetores que usaremos\n"
"        >>> query = \"SELECT zone_id, população, emprego FROM zonas;\"\n"
"        >>> com project.db_connection como conexão:\n"
"        ... df = pd.read_sql(consulta, conexão)\n"
"        >>> df.sort_values(by=\"zone_id\", inplace=True)\n"
"        >>> df.set_index(\"zone_id\", inplace=True)\n"
"\n"
"        # Você cria os vetores que teria\n"
"        >>> df = df.assign(produções=df.população * 3.0)\n"
"        >>> df = df.assign(atrações=df.employment * 4.0)\n"
"        >>> vetores = df[[\"produções\", \"atrações\"]]\n"
"\n"
"        # Equilibre os vetores\n"
"        >>> vetores.loc[:, \"atrações\"] *= vetores[\"produções\"].sum() / vetores[\"atrações\"].sum()\n"
"\n"
"        # Crie o objeto do problema\n"
"        >>> args = {\"impedância\": matriz,\n"
"        ... \"vetores\": vetores,\n"
"        ... \"row_field\": \"produções\",\n"
"        ... \"modelo\": modelo,\n"
"        ... \"column_field\": \"atrações\",\n"
"        ... \"nan_as_zero\": Verdadeiro\n"
"        ... }\n"
"        >>> gravidade = GravityApplication(**args)\n"
"\n"
"        # Resolva e salve as saídas\n"
"        >>> gravidade.apply()\n"
"        >>> gravidade.output.export(project_path / 'matrizes' / 'gravity_omx.omx')\n"
"\n"
"        >>> projeto.close()"

