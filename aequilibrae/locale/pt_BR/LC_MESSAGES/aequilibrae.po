#: aequilibrae/project/network/modes.py:8
msgid ""
"\n"
"    Access to the API resources to manipulate the modes table in the network\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> project = create_example(project_path)\n"
"\n"
"        >>> modes = project.network.modes\n"
"\n"
"        # We can get a dictionary of all modes in the model\n"
"        >>> all_modes = modes.all_modes()\n"
"\n"
"        # And do a bulk change and save it\n"
"        >>> for mode_id, mode_obj in all_modes.items():\n"
"        ...     mode_obj.beta = 1\n"
"        ...     mode_obj.save()\n"
"\n"
"        # or just get one mode in specific\n"
"        >>> car_mode = modes.get('c')\n"
"\n"
"        # or just get this same mode by name\n"
"        >>> car_mode = modes.get_by_name('car')\n"
"\n"
"        # We can change the description of the mode\n"
"        >>> car_mode.description = 'personal autos only'\n"
"\n"
"        # Let's say we are using alpha to store the PCE for a future year with much smaller cars\n"
"        >>> car_mode.alpha = 0.95\n"
"\n"
"        # To save this mode we can simply\n"
"        >>> car_mode.save()\n"
"\n"
"        # We can also create a completely new mode and add to the model\n"
"        >>> new_mode = modes.new('k')\n"
"        >>> new_mode.mode_name = 'flying_car'  # Only ASCII letters and *_* allowed # other fields are not mandatory\n"
"\n"
"        # We then explicitly add it to the network\n"
"        >>> modes.add(new_mode)\n"
"\n"
"        # we can even keep editing and save it directly once we have added it to the project\n"
"        >>> new_mode.description = 'this is my new description'\n"
"        >>> new_mode.save()\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Acesso aos recursos da API para manipular a tabela de modos na rede\n"
"\n"
"    .. bloco de código :: python\n"
"\n"
"        >>> projeto = create_example(project_path)\n"
"\n"
"        >>> modos = project.network.modes\n"
"\n"
"        # Podemos obter um dicionário de todos os modos do modelo\n"
"        >>> all_modes = modos.all_modes()\n"
"\n"
"        # E faça uma alteração em massa e salve-a\n"
"        >>> para mode_id, mode_obj em all_modes.items():\n"
"        ... modo_obj.beta = 1\n"
"        ... mode_obj.save()\n"
"\n"
"        # ou apenas obtenha um modo específico\n"
"        >>> modo_carro = modos.get('c')\n"
"\n"
"        # ou apenas obtenha este mesmo modo pelo nome\n"
"        >>> modo_carro = modos.get_by_name('carro')\n"
"\n"
"        # Podemos alterar a descrição do modo\n"
"        >>> car_mode.description = 'somente automóveis pessoais'\n"
"\n"
"        # Digamos que estamos usando alfa para armazenar o PCE para um ano futuro com carros muito menores\n"
"        >>> modo_carro.alpha = 0,95\n"
"\n"
"        # Para salvar este modo podemos simplesmente\n"
"        >>> carro_mode.save()\n"
"\n"
"        # Também podemos criar um modo completamente novo e adicionar ao modelo\n"
"        >>> novo_modo = modos.new('k')\n"
"        >>> new_mode.mode_name = 'flying_car' # Somente letras ASCII e *_* permitidas # outros campos não são "
"obrigatórios\n"
"\n"
"        # Em seguida, adicionamos explicitamente à rede\n"
"        >>> modos.add(novo_modo)\n"
"\n"
"        # podemos até continuar editando e salvando-o diretamente depois de adicioná-lo ao projeto\n"
"        >>> new_mode.description = 'esta é minha nova descrição'\n"
"        >>> novo_modo.save()\n"
"\n"
"        >>> projeto.close()"

#: aequilibrae/project/network/nodes.py:13
