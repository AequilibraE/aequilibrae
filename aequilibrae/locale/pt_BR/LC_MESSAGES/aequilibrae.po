#: aequilibrae/utils/simwrapper/generate_simwrapper_config.py:1
msgid ""
"Utilities to generate SimWrapper dashboard configuration for an AequilibraE project.\n"
"\n"
"Usage\n"
"-----\n"
".. code-block:: python\n"
"    :caption: Generate SimWrapper dashboard for an open project\n"
"\n"
"    >>> from aequilibrae.project import Project\n"
"    >>> from aequilibrae.utils.simwrapper.generate_simwrapper_config import SimwrapperConfigGenerator\n"
"    >>> prj = Project()\n"
"    >>> prj.open('/path/to/project')\n"
"    >>> gen = SimwrapperConfigGenerator(prj, output_dir='simwrapper')\n"
"    >>> gen.write_yamls()\n"
"\n"
"Notes\n"
"-----\n"
"- `output_dir` must be inside the project directory\n"
msgstr ""
"Utilitários para gerar a configuração do painel SimWrapper para um projeto AequilibraE.\n"
"\n"
"Uso\n"
"-----\n"
".. bloco de código :: python\n"
"    :caption: Gere o painel do SimWrapper para um projeto aberto\n"
"\n"
"    >>> do projeto de importação aequilibrae.project\n"
"    >>> de aequilibrae.utils.simwrapper.generate_simwrapper_config importar SimwrapperConfigGenerator\n"
"    >>> prj = Projeto()\n"
"    >>> prj.open('/caminho/para/projeto')\n"
"    >>> gen = SimwrapperConfigGenerator(prj, output_dir='simwrapper')\n"
"    >>> gen.write_yamls()\n"
"\n"
"Notas\n"
"-----\n"
"- `output_dir` deve estar dentro do diretório do projeto"

