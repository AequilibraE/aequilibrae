#: aequilibrae/project/network/link.py:8
msgid ""
"A Link object represents a single record in the *links* table\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> project = create_example(project_path)\n"
"\n"
"        >>> all_links = project.network.links\n"
"\n"
"        # Let's get a mode to work with\n"
"        >>> modes = project.network.modes\n"
"        >>> car_mode = modes.get('c')\n"
"\n"
"        # We can just get one link in specific\n"
"        >>> link1 = all_links.get(3)\n"
"        >>> link2 = all_links.get(17)\n"
"\n"
"        # We can find out which fields exist for the links\n"
"        >>> which_fields_do_we_have = link1.data_fields()\n"
"\n"
"        # And edit each one like this\n"
"        >>> link1.lanes_ab = 3\n"
"        >>> link1.lanes_ba = 2\n"
"\n"
"        # we can drop a mode from the link\n"
"        >>> link1.drop_mode(car_mode)  # or link1.drop_mode('c')\n"
"\n"
"        # we can add a mode to the link\n"
"        >>> link2.add_mode(car_mode)  # or link2.add_mode('c')\n"
"\n"
"        # Or set all modes at once\n"
"        >>> link2.set_modes('cbtw')\n"
"\n"
"        # We can just save the link\n"
"        >>> link1.save()\n"
"        >>> link2.save()\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Um objeto Link representa um único registro na tabela *links*\n"
"\n"
"    .. bloco de código :: python\n"
"\n"
"        >>> projeto = create_example(project_path)\n"
"\n"
"        >>> all_links = project.network.links\n"
"\n"
"        # Vamos criar um modo para trabalhar\n"
"        >>> modos = project.network.modes\n"
"        >>> modo_carro = modos.get('c')\n"
"\n"
"        # Podemos obter apenas um link específico\n"
"        >>> link1 = todos_links.get(3)\n"
"        >>> link2 = todos_links.get(17)\n"
"\n"
"        # Podemos descobrir quais campos existem para os links\n"
"        >>> quais_campos_nós_temos = link1.data_fields()\n"
"\n"
"        # E edite cada um assim\n"
"        >>> link1.lanes_ab = 3\n"
"        >>> link1.lanes_ba = 2\n"
"\n"
"        # podemos descartar um modo do link\n"
"        >>> link1.drop_mode(car_mode) # ou link1.drop_mode('c')\n"
"\n"
"        # podemos adicionar um modo ao link\n"
"        >>> link2.add_mode(car_mode) # ou link2.add_mode('c')\n"
"\n"
"        # Ou defina todos os modos de uma vez\n"
"        >>> link2.set_modes('cbtw')\n"
"\n"
"        # Podemos apenas salvar o link\n"
"        >>> link1.save()\n"
"        >>> link2.save()\n"
"\n"
"        >>> projeto.close()"

#: aequilibrae/project/network/node.py:10
msgid ""
"A Node object represents a single record in the *nodes* table\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> from shapely.geometry import Point\n"
"\n"
"        >>> project = create_example(project_path)\n"
"\n"
"        >>> all_nodes = project.network.nodes\n"
"\n"
"        # We can just get one link in specific\n"
"        >>> node1 = all_nodes.get(7)\n"
"\n"
"        # We can find out which fields exist for the links\n"
"        >>> which_fields_do_we_have = node1.data_fields()\n"
"\n"
"        # It success if the node_id already does not exist\n"
"        >>> node1.renumber(998877)\n"
"\n"
"        >>> node1.geometry = Point(1,2)\n"
"\n"
"        # We can just save the node\n"
"        >>> node1.save()\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Um objeto Node representa um único registro na tabela *nodes*\n"
"\n"
"    .. bloco de código :: python\n"
"\n"
"        >>> do ponto de importação shapely.geometry\n"
"\n"
"        >>> projeto = create_example(project_path)\n"
