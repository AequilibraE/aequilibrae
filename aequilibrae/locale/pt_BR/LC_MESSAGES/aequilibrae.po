#: aequilibrae/paths/connectivity_analysis.py:13
msgid ""
"\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> from aequilibrae.paths.connectivity_analysis import ConnectivityAnalysis\n"
"\n"
"        >>> project = create_example(project_path)\n"
"\n"
"        >>> network = project.network\n"
"        >>> network.build_graphs()\n"
"\n"
"        >>> graph = network.graphs['c']\n"
"        >>> graph.set_graph(cost_field=\"distance\")\n"
"        >>> graph.set_blocked_centroid_flows(False)\n"
"\n"
"        >>> conn_test = ConnectivityAnalysis(graph)\n"
"        >>> conn_test.execute()\n"
"\n"
"        # The connectivity tester report as a Pandas DataFrame\n"
"        >>> disconnected = conn_test.disconnected_pairs\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
".. bloco de código :: python\n"
"\n"
"        >>> de aequilibrae.paths.connectivity_análise importar ConnectivityAnalysis\n"
"\n"
"        >>> projeto = create_example(project_path)\n"
"\n"
"        >>> rede = projeto.rede\n"
"        >>> rede.build_graphs()\n"
"\n"
"        >>> gráfico = rede.gráficos['c']\n"
"        >>> gráfico.set_graph(cost_field=\"distância\")\n"
"        >>> gráfico.set_blocked_centroid_flows(Falso)\n"
"\n"
"        >>> conn_test = ConnectivityAnalysis(gráfico)\n"
"        >>> conn_test.execute()\n"
"\n"
"        # O relatório do testador de conectividade como um Pandas DataFrame\n"
"        >>> desconectado = conn_test.disconnected_pairs\n"
"\n"
"        >>> projeto.close()"

#: aequilibrae/paths/network_skimming.py:21
msgid ""
"\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> from aequilibrae.paths.network_skimming import NetworkSkimming\n"
"\n"
"        >>> project = create_example(project_path)\n"
"        >>> project.network.build_graphs(modes=[\"c\"])\n"
"\n"
"        >>> graph = project.network.graphs['c']\n"
"        >>> graph.set_graph(\"distance\")\n"
"        >>> graph.set_skimming(\"distance\")\n"
"\n"
"        >>> skm = NetworkSkimming(graph)\n"
"        >>> skm.execute()\n"
"\n"
"        # The skim report (if any error generated) is available here\n"
"        >>> skm.report\n"
"        []\n"
"\n"
"        # To access the skim matrix directly from its temporary file\n"
"        >>> matrix = skm.results.skims\n"
"\n"
"        # Or you can save the results to disk\n"
"        >>> skm.save_to_project('skimming_result_omx', 'omx')\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
".. bloco de código :: python\n"
"\n"
"        >>> de aequilibrae.paths.network_skimming importar NetworkSkimming\n"
"\n"
"        >>> projeto = create_example(project_path)\n"
"        >>> project.network.build_graphs(modos=[\"c\"])\n"
"\n"
"        >>> gráfico = project.network.graphs['c']\n"
"        >>> graph.set_graph(\"distância\")\n"
"        >>> graph.set_skimming(\"distância\")\n"
"\n"
"        >>> skm = NetworkSkimming (gráfico)\n"
"        >>> skm.execute()\n"
"\n"
"        # O relatório de skim (se algum erro for gerado) está disponível aqui\n"
"        >>> skm.relatório\n"
"        []\n"
"\n"
"        # Para acessar a matriz skim diretamente de seu arquivo temporário\n"
"        >>> matriz = skm.resultados.skims\n"
"\n"
"        # Ou você pode salvar os resultados em disco\n"
"        >>> skm.save_to_project('skimming_result_omx', 'omx')\n"
"\n"
"        >>> projeto.close()"

