#: aequilibrae/distribution/ipf.py:17
#, python-brace-format
msgid ""
"Iterative proportional fitting procedure\n"
"\n"
"    .. code-block:: python\n"
"\n"
"        >>> from aequilibrae.distribution import Ipf\n"
"\n"
"        >>> project = create_example(project_path)\n"
"\n"
"        >>> matrix = project.matrices.get_matrix(\"demand_omx\")\n"
"        >>> matrix.computational_view()\n"
"\n"
"        >>> vectors = pd.DataFrame(\n"
"        ...     {\"productions\": np.zeros(matrix.zones), \"attractions\": np.zeros(matrix.zones)},\n"
"        ...     index=matrix.index,\n"
"        ... )\n"
"\n"
"        >>> vectors[\"productions\"] = matrix.rows()\n"
"        >>> vectors[\"attractions\"] = matrix.columns()\n"
"\n"
"        >>> ipf_args = {\"matrix\": matrix,\n"
"        ...             \"vectors\": vectors,\n"
"        ...             \"row_field\": \"productions\",\n"
"        ...             \"column_field\": \"attractions\",\n"
"        ...             \"nan_as_zero\": False}\n"
"\n"
"        >>> fratar = Ipf(**ipf_args)\n"
"        >>> fratar.fit()\n"
"\n"
"        # We can get back to our OMX matrix in the end\n"
"        >>> fratar.output.export(Path(my_folder_path) / \"to_omx_output.omx\")\n"
"\n"
"        >>> project.close()\n"
"    "
msgstr ""
"Procedimento de ajuste proporcional iterativo\n"
"\n"
"    .. bloco de código :: python\n"
"\n"
"        >>> de aequilibrae.distribution importar Ipf\n"
"\n"
"        >>> projeto = create_example(project_path)\n"
"\n"
"        >>> matriz = project.matrices.get_matrix(\"demand_omx\")\n"
"        >>> matriz.computational_view()\n"
"\n"
"        >>> vetores = pd.DataFrame(\n"
"        ... {\"produções\": np.zeros(matrix.zones), \"atrações\": np.zeros(matrix.zones)},\n"
"        ... índice = matriz. índice,\n"
"        ...)\n"
"\n"
"        >>> vetores[\"produções\"] = matriz.rows()\n"
"        >>> vetores[\"atrações\"] = matriz.colunas()\n"
"\n"
"        >>> ipf_args = {\"matriz\": matriz,\n"
"        ... \"vetores\": vetores,\n"
"        ... \"row_field\": \"produções\",\n"
"        ... \"column_field\": \"atrações\",\n"
"        ... \"nan_as_zero\": Falso}\n"
"\n"
"        >>> fratar = Ipf(**ipf_args)\n"
"        >>> fratar.fit()\n"
"\n"
"        # Podemos voltar à nossa matriz OMX no final\n"
"        >>> fratar.output.export(Path(my_folder_path) / \"to_omx_output.omx\")\n"
"\n"
"        >>> projeto.close()"

#: aequilibrae/transit/transit_graph_builder.py:250
msgid ""
"Line segments correspond to segments between two successive stops for each line.\n"
"\n"
"        For example if 2 lines, L1 and L2, are going from stop A to stop B, we have 2 line segments:\n"
"        - L1_AB\n"
"        - L2_AB\n"
"\n"
"        line_segments table format:\n"
"            pattern_id  seq    from_stop      to_stop shortname         line_id  trav_time  headway      freq\n"
"        0  10001006000    0  10000000464  10000000462        T2  T2_10001006000      150.0    240.0  0.004167\n"
"        1  10001006000    1  10000000462  10000000459        T2  T2_10001006000      110.0    240.0  0.004167\n"
"        2  10001006000    2  10000000459  10000000160        T2  T2_10001006000      100.0    240.0  0.004167\n"
"        "
msgstr ""
"Os segmentos de linha correspondem a segmentos entre duas paradas sucessivas para cada linha.\n"
"\n"
"        Por exemplo, se 2 linhas, L1 e L2, vão da parada A à parada B, temos 2 segmentos de linha:\n"
"        -L1_AB\n"
"        -L2_AB\n"
"\n"
"        formato da tabela line_segments:\n"
"            pattern_id seq from_stop to_stop nome abreviado line_id trav_time headway freq\n"
"        0 10001006000 0 10000000464 10000000462 T2 T2_10001006000 150,0 240,0 0,004167\n"
"        1 10001006000 1 10000000462 10000000459 T2 T2_10001006000 110,0 240,0 0,004167\n"
"        2 10001006000 2 10000000459 10000000160 T2 T2_10001006000 100,0 240,0 0,004167"

